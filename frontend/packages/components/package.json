{
  "name": "@microbiome-informatics/samplesift",
  "version": "0.1.0",
  "description": "Framework-agnostic spatial sample explorer built with Lit and MapLibre",
  "type": "module",
  "files": [
    "dist",
    "COLLECTION_API.md",
    "STYLING.md",
    "examples",
    "scripts"
  ],
  "main": "./dist/sample-sift.js",
  "module": "./dist/sample-sift.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sample-sift.js"
    },
    "./data": {
      "types": "./dist/types/data/index.d.ts",
      "import": "./dist/data.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json && node scripts/prepare-package.mjs",
    "build:django": "vite build --outDir ../../../src/samplesift/django/static/samplesift/components --emptyOutDir && node scripts/prepare-package.mjs ../../../src/samplesift/django/static/samplesift/components",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "prepack": "npm run build && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@golemui/core": "2.1.1",
    "@golemui/gui-components": "2.1.1",
    "@golemui/gui-lit": "2.1.1",
    "@golemui/gui-schemas": "2.1.1",
    "@golemui/gui-shared": "2.1.1",
    "@golemui/gui-validators": "2.1.1",
    "@golemui/lit": "2.1.1",
    "@golemui/schemas": "2.1.1",
    "@lit/context": "1.1.6",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@types/geojson": "7946.0.16",
    "lit": "3.3.3",
    "maplibre-gl": "6.17.0",
    "rxjs": "7.8.2",
    "terra-draw": "1.39.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EBI-Metagenomics/samplesift.git",
    "directory": "frontend/packages/components"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": true,
  "keywords": [
    "web-components",
    "lit",
    "maplibre",
    "geospatial",
    "biodiversity",
    "samplesift"
  ],
  "homepage": "https://github.com/EBI-Metagenomics/samplesift#readme",
  "bugs": {
    "url": "https://github.com/EBI-Metagenomics/samplesift/issues"
  }
}
