{
  "name": "samplesift-frontend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @microbiome-informatics/samplesift",
    "build": "npm run build --workspace @microbiome-informatics/samplesift",
    "build:django": "npm run build:django --workspace @microbiome-informatics/samplesift",
    "typecheck": "npm run typecheck --workspace @microbiome-informatics/samplesift",
    "test": "npm run test --workspace @microbiome-informatics/samplesift",
    "test:browser": "npm run test:browser --workspace @microbiome-informatics/samplesift",
    "lint": "biome lint .",
    "preview": "npm run preview --workspace @microbiome-informatics/samplesift"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
